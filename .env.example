# GGISP Platform v0.2 Environment Configuration

# Custom local SQLite database path (optional, defaults to data/ggisp.db)
GGISP_DB_PATH=data/ggisp.db

# Optional AI Drafting API key (external provider; charges may apply)
# The application functions completely without an external key using built-in heuristic synthesis.
OPENAI_API_KEY=

# Optional AI Model name
GGISP_AI_MODEL=gpt-4o-mini

# Optional World Trade Organization API key
WTO_API_KEY=
