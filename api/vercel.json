{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "pricing.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/pricing",
      "dest": "/pricing.html"
    },
    {
      "src": "/stripe",
      "dest": "/pricing.html"
    },
    {
      "src": "/plans",
      "dest": "/pricing.html"
    },
    {
      "src": "/enquiries",
      "dest": "/pricing.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
